# Supabase (local values come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (test keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=tickets@example.com
SUPPORT_EMAIL=support@example.com

# Jobs: must match the vault secret `cron_secret` (seed.sql sets local-cron-secret locally)
CRON_SECRET=local-cron-secret

# Rate limiting (optional locally, required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Errors (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Zoho Payments (run scripts from indian-squad for a refresh token)
NEXT_PUBLIC_ZOHO_PAY_ACCOUNT_ID=
NEXT_PUBLIC_ZOHO_PAY_API_KEY=
NEXT_PUBLIC_ZOHO_PAY_SANDBOX=false
ZOHO_PAY_CLIENT_ID=
ZOHO_PAY_CLIENT_SECRET=
ZOHO_PAY_REFRESH_TOKEN=
ZOHO_PAY_WEBHOOK_SIGNING_KEY=
